# Copy to .env.local for local development.
# In production these three live in the Vercel project's Environment Variables.

# Injected automatically by the Neon integration on Vercel.
DATABASE_URL=

# The single shared password you and your wife type to sign in.
APP_PASSWORD=

# Signs the session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
